{
  "name": "labrute-pixi-fighter",
  "version": "1.0.13",
  "description": "PixiJS fighter animations and FLA symbol data for LaBrute.",
  "main": "dist/Symbols.js",
  "module": "dist/Symbols.js",
  "types": "dist/Symbols.d.ts",
  "scripts": {
    "build": "rollup --config && rollup --config rollup-declarations.config.mjs && node -e \"require('fs').rmSync('dist/src', { recursive: true, force: true })\"",
    "test": "webpack serve --mode development",
    "deploy": "npm publish",
    "export-xml": "ts-node ./src/exportXmlAsJson.ts",
    "test:unit": "node --test test/FighterHolder.test.cjs",
    "prepublishOnly": "npm run build && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zenoo/labrute-fla-parser.git"
  },
  "bugs": {
    "url": "https://github.com/Zenoo/labrute-fla-parser/issues"
  },
  "homepage": "https://github.com/Zenoo/labrute-fla-parser#readme",
  "keywords": [
    "twinoid",
    "muxxu",
    "motion-twin",
    "mybrute",
    "labrute",
    "parser",
    "fla",
    "xml",
    "pixi",
    "fighter",
    "animation"
  ],
  "author": "Zenoo",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.17.8",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-typescript": "^7.16.7",
    "@rollup/plugin-json": "^6.0.1",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "babel-loader": "^8.2.3",
    "dotenv": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-prettier": "^3.1.4",
    "html-webpack-plugin": "^5.5.0",
    "pixi.js": "^8.19.0",
    "rollup": "^4.2.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.6.3",
    "webpack": "^5.65.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1",
    "xml-js": "^1.6.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "files": [
    "dist/Symbols.js",
    "dist/Symbols.d.ts",
    "examples/ProductionFighterHolder.ts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
